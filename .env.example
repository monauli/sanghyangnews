# Kunci Gemini — ambil gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model Gemini. Boleh dikosongkan — default: gemini-3.5-flash-lite.
# Diganti dari dashboard kalau kuota atau kualitasnya tidak cocok.
# JANGAN pakai gemini-2.5-flash-lite: masih terdaftar tapi membalas 404.
GEMINI_MODEL=

# Sandi bersama untuk masuk ke aplikasi.
# WAJIB diisi. Kalau kosong, aplikasi mengunci diri (semua request ditolak 503).
APP_PASSWORD=
